{
    "name": "php-baremetal/ext-spi",
    "description": "Baremetal\\Spi\\Bus + \\Device and the device-driver framework. Drivers are packages registering into the spi_drivers registry; the platform side is a spi-hal package.",
    "type": "bm-ext",
    "license": "MIT",
    "authors": [
        {
            "name": "Gianfrancesco Aurecchia",
            "email": "gianfri@php-baremetal.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "php-baremetal/spi-hal": "^1.0",
        "php-baremetal/bm-common": "^1.0"
    },
    "extra": {
        "baremetal": {
            "module": "spi",
            "priority": 100,
            "registries": {
                "spi_drivers": {
                    "type": "spi_driver_desc_t",
                    "header": "spi_driver_desc.h"
                }
            }
        }
    }
}
